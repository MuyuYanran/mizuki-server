#!/usr/bin/env node
'use strict';

/**
 * [阶段 P11] bin/mizuki-server — 生产启动脚本（P11 §3.3）
 * [职责] 加载编译产物 dist/main.js；端口遵循 MIZUKI_SERVER_PORT（默认 20154）；
 *   启动横幅（服务名 + 面板地址 + Swagger 地址）。运行前需先 pnpm build。
 * [用法] node apps/server/bin/mizuki-server（或经 npm bin 链接为 mizuki-server）
 */

const { existsSync } = require('node:fs');
const path = require('node:path');

const port = Number(process.env.MIZUKI_SERVER_PORT ?? 20154);
const mainPath = path.resolve(__dirname, '..', 'dist', 'main.js');

if (!existsSync(mainPath)) {
  console.error('[mizuki-server] 未找到编译产物 dist/main.js —— 请先在仓库根执行 pnpm build');
  process.exitCode = 1;
} else {
  const line = '─'.repeat(52);
  console.log(`\n${line}`);
  console.log('  Mizuki-Server');
  console.log(`  面板 / API ：http://localhost:${port}`);
  console.log(`  Swagger    ：http://localhost:${port}/api/v1/docs`);
  console.log(`${line}\n`);
  // 显式调用导出的 bootstrap()（main.ts 的 require.main 守卫在 require 场景不成立）
  require(mainPath)
    .bootstrap()
    .catch((err) => {
      console.error('[mizuki-server] 启动失败:', err);
      process.exitCode = 1;
    });
}
