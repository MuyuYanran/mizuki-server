# Mizuki-Server 环境变量示例
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略）

# 服务监听端口（默认 20154）
MIZUKI_SERVER_PORT=20154

# 运行环境：development | production
NODE_ENV=development

# ── AI 接入（U4-AI1）──────────────────────────────────────────────
# provider 密钥的**覆盖通道**：设置了它就优先于 config.json 里的 ai.profiles[].apiKey，
# 面板会显示 keySource=env 并把 key 输入框置灰（避免「改了没生效」的困惑）。
# 生产环境推荐用本变量注入，让密钥不落任何磁盘文件。
MIZUKI_AI_API_KEY=

# 只覆盖**当前档案**的 baseUrl / model（容器化部署用；面板仍可切档案）
MIZUKI_AI_BASE_URL=
MIZUKI_AI_MODEL=

# 仅测试用：apps/server/test/p10d-ai-live.e2e-spec.ts 的真链路门禁。
# 未设置时该 spec 整块跳过（刻意不进 CI：CI 不应依赖外部付费服务）。
# 用法：MIZUKI_AI_LIVE_KEY=sk-xxx pnpm --filter @mizuki/server exec vitest run \
#         test/p10d-ai-live.e2e-spec.ts --maxWorkers=1
MIZUKI_AI_LIVE_KEY=

