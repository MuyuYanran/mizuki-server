# =============================================================================
# Mizuki-Ts-Server .gitattributes
# pnpm monorepo · NestJS 后端 · Vue 3 前端 · TypeScript
# 统一换行符 / 明确文本与二进制 / 优化 diff 与 GitHub 语言统计
# =============================================================================

# ── 核心：自动识别文本与二进制，入库一律存为 LF ──
* text=auto

# ── 源码与配置文件：强制以 LF 入库并在检出时保持 LF ──
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.vue        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.mdx        text eol=lf
.env.example text eol=lf
.editorconfig text eol=lf
.gitignore   text eol=lf

# ── Windows 批处理脚本：保留 CRLF，保证 cmd.exe 正确解析 ──
*.bat        text eol=crlf
*.cmd        text eol=crlf
# PowerShell 脚本用 LF 即可（现代 PowerShell 兼容）
*.ps1        text eol=lf
# Shell 脚本
*.sh         text eol=lf

# ── 锁定文件：作为文本入库，但不参与 diff（避免刷屏噪音） ──
pnpm-lock.yaml text eol=lf -diff

# ── 构建产物 / 生成文件：不计入 diff、不计入语言统计 ──
*.map            text eol=lf -diff linguist-generated
*.tsbuildinfo    linguist-generated
dist/            linguist-generated
build/           linguist-generated

# ── 二进制资源（前端常见）：明确标记 binary，避免误判与无效 diff ──
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
*.tgz   binary
*.7z    binary
*.sqlite binary
*.db    binary
# SVG 是文本格式，不要当作二进制
*.svg   text eol=lf

# ── GitHub 语言统计：文档与 CI 不计入主语言条 ──
docs/**     linguist-documentation
.github/**  linguist-vendored export-ignore

# ── 追加型文件：合并时使用 union 策略，避免 CHANGELOG 冲突 ──
CHANGELOG.md merge=union
